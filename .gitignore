# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local
supabase/.temp/
supabase/.branches/

# impeccable working files (screenshots); PRODUCT.md and surface briefs are committed
.impeccable/review/
.impeccable/mocks/
.impeccable/build/

# local tooling
.claude/
test-results/
playwright-report/
.impeccable/questions/
.impeccable/hook.cache.json

# Not part of this app (local notes)
reports/
research_notes/
