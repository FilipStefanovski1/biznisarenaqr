  "narrative": {
    "northStar": "The Results Studio",
    "overview": "The LED is an election-night results studio built for a business stage, and every phone is a polling station: ballot, confirmation, receipt. The system is a broadcast graphics package laid over a deep navy studio ground lit by one soft key light from above. Information arrives as sharp slabs with a single chamfered leading corner, white lower-third panels carrying navy type, and solid team colour tabs that identify each contestant without logos.\n\nColour is assigned by meaning, not decoration. Electric blue means \"live\" or \"your active choice\"; gold means \"leading\" or \"declared winner\"; the three team hues mean identity and nothing else. Type is condensed and heavy for names and numerals so they read from the back row, with a sturdy text face for running copy across Cyrillic and Latin scripts. Motion is broadcast grammar: horizontal clip-path wipes and numeric rolls on an expo-out curve, all optional under reduced motion.\n\nThe system refuses the live-poll dashboard: no rounded glowing cards, no neon bars, no gradient fills on data.",
    "keyCharacteristics": [
      "Navy studio ground with a single radial key light at the top.",
      "Sharp slabs (radius 0 to 3px) with one chamfered top-left corner.",
      "White lower-third panels with navy type.",
      "Team identity as a solid vertical colour tab, never a fill on the whole slab.",
      "Blue for LIVE and active choice only; gold for leader and winner only.",
      "Condensed uppercase names, tabular numerals.",
      "Wipes and numeric rolls, not fades and bounces."
    ],
    "rules": [
      {
        "name": "The One Meaning Rule",
        "body": "Blue is live/active, gold is leader/winner, team hues are identity. A colour never borrows another's meaning; if an element is neither live nor winning nor a team, it is navy, paper, or white.",
        "section": "colors"
      },
      {
        "name": "The Equal Ground Rule",
        "body": "Until votes decide, the three contestants get identical slabs, identical type and identical tab widths. Only the leader flag, the leader slab tone, and the gold call may single one out.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that changes live (counts, totals, percentages, receipt times) is set tabular so columns do not jitter as votes arrive.",
        "section": "typography"
      },
      {
        "name": "The Condensed Name Rule",
        "body": "Team names are always the condensed face, uppercase, 800. Never set a contestant name in the text face.",
        "section": "typography"
      },
      {
        "name": "The Flat Slab Rule",
        "body": "Navy slabs never carry shadows or glows; they are separated by tone and gap alone. Only paper surfaces floating over navy get a soft, dark shadow.",
        "section": "elevation"
      },
      {
        "name": "The One Cut Rule",
        "body": "A slab gets one chamfered corner, the leading top-left. Never chamfer all corners, never round a slab beyond 3px.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do size every LED element in `u` so the stage scales as one 16:9 unit with no scrolling.",
      "Do give each slab exactly one chamfered top-left corner and keep corners at or under 3px.",
      "Do mark a team with a solid vertical colour tab and a solid bar fill in its fixed hue.",
      "Do set every changing number tabular in Fira Sans Condensed.",
      "Do put navy type on paper lower-thirds and white type on navy slabs.",
      "Do move with clip-path wipes and numeric rolls on the broadcast ease, and leave content visible when motion is reduced."
    ],
    "donts": [
      "Don't use Live Blue for anything that is not live state or the active choice, or gold for anything that is not leader or winner.",
      "Don't build rounded glowing cards, neon or gradient bars, or glows on navy slabs.",
      "Don't give one contestant more size, colour or position emphasis than the others before votes decide.",
      "Don't invent contestant logos, photos, descriptions or statistics; the colour tab and name are the whole identity.",
      "Don't set contestant names in the text face or in mixed case."
    ]
  }
}