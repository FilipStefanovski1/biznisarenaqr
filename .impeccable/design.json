  "components": [
    {
      "name": "Ballot Slab",
      "kind": "custom",
      "refersTo": "ballot-slab",
      "description": "One equal, full-width team slab on the phone ballot; tapping opens the confirm sheet.",
      "html": "<button class=\"ds-ballot\"><span class=\"ds-ballot-tab\" style=\"background:#ef6f5e\"></span><span class=\"ds-ballot-name\">YOVA</span><span class=\"ds-ballot-go\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\" stroke-linecap=\"square\"/></svg></span></button>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-ballot{position:relative;display:flex;align-items:center;width:340px;min-height:96px;border:0;background:var(--color-navy-800);color:#fff;text-align:left;cursor:pointer;clip-path:polygon(14px 0,100% 0,100% 100%,0 100%,0 14px);transition:background .2s}.ds-ballot:hover,.ds-ballot:active{background:var(--color-navy-700)}.ds-ballot:focus-visible{outline:3px solid var(--color-blue);outline-offset:3px}.ds-ballot-tab{position:absolute;inset:0 auto 0 0;width:14px;transition:width .3s var(--ease-broadcast)}.ds-ballot:hover .ds-ballot-tab{width:20px}.ds-ballot:active .ds-ballot-tab{width:24px}.ds-ballot-name{flex:1;padding:20px 12px 20px 36px;font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:34px;font-weight:800;line-height:.95;letter-spacing:-.005em;text-transform:uppercase}.ds-ballot-go{display:flex;align-items:center;justify-content:center;width:48px;height:48px;margin-right:16px;border-radius:3px;background:rgba(255,255,255,.07);transition:background .2s,color .2s}.ds-ballot:hover .ds-ballot-go{background:var(--color-blue);color:var(--color-navy)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Confirm-vote action inside the confirm sheet.",
      "html": "<button class=\"ds-btn-primary\">YES, VOTE</button>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-btn-primary{display:flex;align-items:center;justify-content:center;width:320px;height:60px;border:0;border-radius:3px;background:var(--color-blue);color:var(--color-navy);font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:21px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;transition:filter .2s}.ds-btn-primary:hover{filter:brightness(1.05)}.ds-btn-primary:active{filter:brightness(.95)}.ds-btn-primary:focus-visible{outline:3px solid var(--color-blue);outline-offset:3px}"
    },
    {
      "name": "Paper Button",
      "kind": "button",
      "refersTo": "button-paper",
      "description": "Secondary full-width action on navy (retry after a failed load).",
      "html": "<button class=\"ds-btn-paper\">TRY AGAIN</button>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-btn-paper{width:320px;height:56px;border:0;border-radius:3px;background:var(--color-mist);color:var(--color-navy);font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:20px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;transition:background .2s}.ds-btn-paper:hover{background:#fff}.ds-btn-paper:focus-visible{outline:3px solid var(--color-blue);outline-offset:3px}"
    },
    {
      "name": "Status Bugs",
      "kind": "chip",
      "refersTo": "live-bug",
      "description": "Arrow-chamfered status bug: blue LIVE with pulsing dot, gold FINAL.",
      "html": "<div class=\"ds-bugs\"><span class=\"ds-bug ds-bug-live\"><span class=\"ds-bug-dot\"></span>LIVE</span><span class=\"ds-bug ds-bug-final\">FINAL RESULTS</span></div>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-bugs{display:flex;gap:12px}.ds-bug{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 16px 0 10px;font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--color-navy);clip-path:polygon(0 0,calc(100% - .7em) 0,100% 50%,calc(100% - .7em) 100%,0 100%)}.ds-bug-live{background:var(--color-blue)}.ds-bug-final{background:var(--color-gold)}.ds-bug-dot{width:8px;height:8px;border-radius:50%;background:currentColor;animation:ds-pulse 1.4s ease-in-out infinite}@keyframes ds-pulse{50%{opacity:.25}}@media (prefers-reduced-motion:reduce){.ds-bug-dot{animation:none}}"
    },
    {
      "name": "Result Row",
      "kind": "card",
      "refersTo": "slab-navy",
      "description": "LED result row: team tab, condensed name, leader flag, bar, tabular count and percent.",
      "html": "<div class=\"ds-row\"><span class=\"ds-row-tab\" style=\"background:#ef6f5e\"></span><div class=\"ds-row-body\"><div class=\"ds-row-name\">YOVA <span class=\"ds-flag\">LEADS</span></div><div class=\"ds-track\"><div class=\"ds-fill\" style=\"width:43%;background:#ef6f5e\"></div></div></div><div class=\"ds-figs\"><div class=\"ds-count\">19</div><div class=\"ds-pct\">43.2%</div></div></div>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-row{display:grid;grid-template-columns:22px 1fr 180px;width:720px;min-height:150px;background:#142852;color:#fff;clip-path:polygon(22px 0,100% 0,100% 100%,0 100%,0 22px)}.ds-row-body{display:flex;flex-direction:column;justify-content:center;gap:16px;padding:20px 20px 20px 26px}.ds-row-name{display:flex;align-items:center;gap:16px;font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:58px;font-weight:800;line-height:.95;text-transform:uppercase}.ds-flag{padding:5px 18px 5px 12px;background:var(--color-gold);color:var(--color-navy);font-size:16px;font-weight:800;letter-spacing:.14em;clip-path:polygon(0 0,calc(100% - 9px) 0,100% 50%,calc(100% - 9px) 100%,0 100%)}.ds-track{position:relative;height:32px;background:rgba(255,255,255,.07)}.ds-fill{position:absolute;inset:0 auto 0 0;transition:width .9s var(--ease-broadcast)}.ds-figs{display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:4px;padding-right:26px;border-left:1px solid rgba(255,255,255,.08);font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-variant-numeric:tabular-nums}.ds-count{font-size:80px;font-weight:700;line-height:.9}.ds-pct{font-size:27px;font-weight:600;color:var(--color-ink-2)}"
    },
    {
      "name": "Lower-third Ticker",
      "kind": "custom",
      "refersTo": "lower-third",
      "description": "Full-width paper lower-third with chamfered navy label, tabular total and live status.",
      "html": "<div class=\"ds-ticker\"><span class=\"ds-ticker-label\">TOTAL VOTES</span><span class=\"ds-ticker-total\">44</span><span class=\"ds-ticker-status\"><span class=\"ds-ticker-dot\"></span>Results update live</span></div>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-ticker{display:flex;align-items:stretch;width:760px;height:64px;background:var(--color-mist);color:var(--color-navy);clip-path:polygon(18px 0,100% 0,100% 100%,0 100%,0 18px)}.ds-ticker-label{display:flex;align-items:center;margin:6px 0 6px 6px;padding:0 24px 0 30px;background:var(--color-navy);color:#fff;font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:20px;font-weight:700;letter-spacing:.1em;clip-path:polygon(13px 0,100% 0,100% 100%,0 100%,0 13px)}.ds-ticker-total{display:flex;align-items:center;padding:0 24px;font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:46px;font-weight:800;font-variant-numeric:tabular-nums}.ds-ticker-status{margin-left:auto;display:flex;align-items:center;gap:8px;padding:0 24px;font-family:'Golos Text',system-ui,sans-serif;font-size:15px;font-weight:600;color:rgba(11,23,54,.62)}.ds-ticker-dot{width:7px;height:7px;border-radius:50%;background:var(--color-blue)}"
    },
    {
      "name": "Confirm Sheet",
      "kind": "custom",
      "refersTo": "lower-third-paper",
      "description": "Paper sheet rising from the bottom with the chosen team's colour strip and the final-vote warning.",
      "html": "<div class=\"ds-sheet\"><div class=\"ds-sheet-strip\" style=\"background:#ef6f5e\"></div><div class=\"ds-sheet-in\"><p class=\"ds-sheet-name\">YOVA</p><p class=\"ds-sheet-q\">Vote for YOVA?</p><p class=\"ds-sheet-note\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><rect x=\"5\" y=\"10.5\" width=\"14\" height=\"10\"/><path d=\"M8 10.5V8a4 4 0 018 0v2.5\"/></svg>Your vote is final and cannot be changed.</p><button class=\"ds-sheet-back\">Back</button></div></div>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-sheet{width:360px;overflow:hidden;border-radius:3px 3px 0 0;background:var(--color-mist);color:var(--color-navy);box-shadow:0 -16px 48px rgba(3,8,22,.5)}.ds-sheet-strip{height:8px}.ds-sheet-in{padding:24px}.ds-sheet-name{margin:0;font-family:'Fira Sans Condensed','Golos Text',sans-serif;font-size:44px;font-weight:800;line-height:.92;text-transform:uppercase}.ds-sheet-q{margin:24px 0 0;font-family:'Golos Text',system-ui,sans-serif;font-size:20px;font-weight:600}.ds-sheet-note{display:flex;gap:8px;margin:8px 0 0;font-family:'Golos Text',system-ui,sans-serif;font-size:15px;color:rgba(11,23,54,.7)}.ds-sheet-back{width:100%;height:48px;margin-top:8px;border:0;background:none;font-family:'Golos Text',system-ui,sans-serif;font-size:16px;font-weight:600;color:rgba(11,23,54,.75);cursor:pointer}.ds-sheet-back:hover{text-decoration:underline;text-underline-offset:4px}.ds-sheet-back:focus-visible{outline:3px solid var(--color-blue);outline-offset:3px}"
    },
    {
      "name": "Language Switcher",
      "kind": "nav",
      "refersTo": "language-switcher",
      "description": "Always-visible phone language control: globe, locale code, chevron.",
      "html": "<button class=\"ds-lang\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c2.6 2.7 3.9 5.7 3.9 9s-1.3 6.3-3.9 9c-2.6-2.7-3.9-5.7-3.9-9S9.4 5.7 12 3z\"/></svg>MK<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\" stroke-linecap=\"square\"/></svg></button>",
      "css": ":root{--color-navy:#0b1736;--color-navy-950:#060e24;--color-navy-800:#0f1f45;--color-navy-700:#172b5c;--color-blue:#0ea5ff;--color-gold:#d4af37;--color-mist:#f4f6fa;--color-ink-2:#c3cddd;--color-muted:#94a3b8;--ease-broadcast:cubic-bezier(0.16,1,0.3,1);}.ds-lang{display:flex;align-items:center;gap:6px;height:40px;padding:0 10px;border:0;border-radius:3px;background:transparent;box-shadow:inset 0 0 0 1px rgba(255,255,255,.15);color:var(--color-ink-2);font-family:'Golos Text',system-ui,sans-serif;font-size:13px;font-weight:600;letter-spacing:.08em;cursor:pointer;transition:background .2s,color .2s}.ds-lang:hover{background:rgba(255,255,255,.05);color:#fff}.ds-lang:focus-visible{outline:3px solid var(--color-blue);outline-offset:3px}"
    },
    {
      "name": "Console Input",
      "kind": "input",
      "refersTo": "lower-third-paper",
      "description": "Organizer console text field on white panels.",
