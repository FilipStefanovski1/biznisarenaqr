# ─────────────────────────────────────────────────────────────────────────────
# Biznis Arena live voting — environment variables
# Copy to .env.local for local development. On the host (e.g. Vercel) set the same
# names in the project's Environment Variables. Run `npm run check:env -- --production`
# before the event.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (Dashboard → Project Settings → API). Public.
#   local:  http://127.0.0.1:54321   (printed by `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key ("sb_publishable_…", or the legacy "anon" JWT). Public — it is shipped
# to browsers and can only call get_public_state() and receive scoreboard broadcasts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key ("sb_secret_…", or the legacy "service_role" JWT). SERVER ONLY.
# Used to record votes after the server verified the voter cookie. Never prefix with
# NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS address of THIS app. The QR code encodes  <PUBLIC_SITE_URL>/vote.
# Production rejects localhost / private IPs / http (the screen shows an error instead
# of a QR). For testing phones on a LAN in development you may use http://192.168.x.x:3000
PUBLIC_SITE_URL=https://glasaj.example.mk

# HMAC secret that signs the anonymous voter cookie and hashes client IPs.
# At least 32 random characters:  openssl rand -hex 32
# Changing it during the event resets every guest's identity (they could vote again).
VOTER_COOKIE_SECRET=replace-with-64-hex-characters-from-openssl-rand

# Generous per-network abuse limit (new votes per minute from one public IP).
# The whole venue usually shares ONE public IP, so keep this well above the audience size.
VOTE_RATE_LIMIT_PER_MINUTE=1500

# Set to "production" on the real event deployment if your host is not Vercel
# (on Vercel, VERCEL_ENV=production is detected automatically). Enables strict URL checks.
# APP_ENV=production

# ── Local testing only (not needed in production) ────────────────────────────
# Test admin used by Playwright e2e tests and `npm run loadtest -- --create-round`.
# E2E_ADMIN_EMAIL=admin@biznisarena.test
# E2E_ADMIN_PASSWORD=choose-a-local-password
